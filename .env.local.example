# Copy to .env.local and fill in real values.
# Generate via: https://aistudio.google.com/apikey

# Gemini API key - SERVER-SIDE ONLY (proxied via server.js, never reaches client bundle).
# Used for: Gemini Flash REST.
GEMINI_API_KEY=

# Google Cloud TTS API key - SERVER-SIDE ONLY. Used by /api/tts/synthesize for
# the RAG answer sentence-parallel TTS (Neural2 voice, LINEAR16 24kHz).
# If left blank, falls back to GEMINI_API_KEY (some Google projects allow it).
GOOGLE_TTS_API_KEY=

# DIAGNOSTIC (2026-09-14): route TTS through a non-Google engine, to test
# whether the client-reported "beep" artifact is specific to the Google TTS
# pipeline. Leave unset/blank for the normal per-language routing (Google
# Cloud TTS, with ne-NP/my-MM always on Azure, ja/en on Fish if configured).
#   "azure"      - EVERY language via Azure Speech (needs AZURE_SPEECH_KEY).
#   "elevenlabs" - EVERY language via ElevenLabs (needs ELEVENLABS_API_KEY).
TTS_ENGINE=

# Preferred auth for BOTH Cloud TTS and Cloud Speech-to-Text (mic input via
# /ws/stt). Single base64 service account JSON, no spaces/newlines. The
# service account must have permission on the project, and BOTH APIs need
# to be enabled separately in the GCP console:
#   - Cloud Text-to-Speech API
#   - Cloud Speech-to-Text API
# Forgetting to enable Speech-to-Text yields:
#   "Cloud Speech-to-Text API has not been used in project ... before"
GOOGLE_TTS_SERVICE_ACCOUNT_BASE64=

# Optional alternatives (usually local dev only; leave empty in CI):
GOOGLE_TTS_SERVICE_ACCOUNT_FILE=
GOOGLE_TTS_SERVICE_ACCOUNT_JSON=

# Azure Speech TTS - used ONLY for languages Google Cloud TTS lacks: Nepali
# (ne-NP-HemkalaNeural) and Burmese (my-MM-NilarNeural). Server-side only.
# Leave the key blank to disable (those languages then have no voice).
# AZURE_SPEECH_REGION defaults to japaneast; the synthesis host is derived as
# {region}.tts.speech.microsoft.com (not the resource's cognitive endpoint).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=japaneast

# Fish Audio TTS - used for Japanese voice (issue 4). Server-side only.
# Leave FISH_AUDIO_API_KEY blank to fall back to Google Cloud TTS for Japanese.
# FISH_AUDIO_VOICE_ID: force ONE voice id for every language (override). Leave
#   blank to use the built-in per-language voice map (ja/en/vi/id). Browse
#   https://fish.audio/voice-library/female/ - the id is in the model URL.
# FISH_AUDIO_MODEL: "s1" (default) or "s2-pro".
# FISH_AUDIO_LANGS: comma-separated language prefixes routed to Fish (default
#   "ja,en" - the only languages Fish officially supports well). ne/my use Azure;
#   vi/id and the rest use Google's native voices. Add "vi,id" to experiment with
#   Fish community voices for those (quality was poor as of 2026-06).
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_MODEL=
FISH_AUDIO_LANGS=

# ElevenLabs TTS - currently only reached via TTS_ENGINE=elevenlabs above
# (not part of normal per-language routing). Outputs raw pcm_24000, no
# pipeline change needed. Leave ELEVENLABS_API_KEY blank to disable.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# RAG service URL - HTTP base of the admin stack (Caddy proxies /api/* to
# rag-api). Web routes append `/api/ai/query` etc. themselves.
# Local dev with admin stack: http://localhost:8001
RAG_SERVICE_URL=http://localhost:8001

# Optional - port the Node server binds to. Defaults to 3001 in this repo.
PORT=3001

# Gemini model IDs per role (all OPTIONAL). Leave unset to use the defaults
# baked into lib/server/models.ts (shown here). Set to swap a model without a
# code change - edit and restart the server, no rebuild. The values must be
# valid Gemini model IDs reachable with GEMINI_API_KEY.
RAG_ANSWER_MODEL=gemini-3.5-flash
RAG_TRANSLATE_MODEL=gemini-2.5-flash
CLASSIFY_MODEL=gemini-2.5-flash-lite
CHITCHAT_MODEL=gemini-2.5-flash
SUGGESTIONS_MODEL=gemini-2.5-flash-lite
NOD_MODEL=gemini-2.5-flash-lite
